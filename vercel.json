{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/r/:slug/print",
      "destination": "/print"
    },
    {
      "source": "/r/:slug",
      "destination": "/report"
    },
    {
      "source": "/s/:slug",
      "destination": "/share"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly",
      "schedule": "0 16 * * 1"
    }
  ]
}